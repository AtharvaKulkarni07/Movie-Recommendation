```gitignore
# ==============================
# Environment Variables & Secrets
# ==============================
.env
.env.*
!.env.example
!.env.sample

# ==============================
# Python / FastAPI
# ==============================
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking & linting
.mypy_cache/
.pyright/
.ruff_cache/

# Logs
*.log

# ==============================
# React / Node.js
# ==============================
node_modules/
dist/
build/
.next/
out/
coverage/

# Package manager logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================
# Vite
# ==============================
.vite/

# ==============================
# IDEs & Editors
# ==============================
.vscode/
.idea/
*.swp
*.swo
*~

# ==============================
# Operating System Files
# ==============================
.DS_Store
Thumbs.db
desktop.ini

# ==============================
# Temporary Files
# ==============================
tmp/
temp/
*.tmp
*.bak

# ==============================
# Database Files
# ==============================
*.sqlite3
*.db

# ==============================
# Jupyter Notebooks
# ==============================
.ipynb_checkpoints/

# ==============================
# Optional: Local Uploads & Storage
# ==============================
uploads/
storage/
```
